
#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"

#define SDA_PIN 4
#define SCL_PIN 5

MAX30105 particleSensor;

const byte RATE_SIZE = 4;
byte rates[RATE_SIZE];
byte rateSpot = 0;

long lastBeat = 0;
float beatsPerMinute;
int beatAvg = 0;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN);

  Serial.println("Starting MAX30102 test...");

  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("ERROR: MAX30102 not found!");
    while (1) delay(100);
  }

  // LED brightness, sample average,
  // LED mode, sample rate, pulse width, ADC range
  particleSensor.setup(60, 4, 2, 100, 411, 4096);

  particleSensor.setPulseAmplitudeRed(0x1F);
  particleSensor.setPulseAmplitudeIR(0x1F);
  particleSensor.setPulseAmplitudeGreen(0);

  Serial.println("MAX30102 connected successfully!");
  Serial.println("Place your finger gently on the sensor.");
}

void loop() {

  long irValue = particleSensor.getIR();
  long redValue = particleSensor.getRed();

  Serial.print("IR Value: ");
  Serial.print(irValue);

  Serial.print(" | RED Value: ");
  Serial.println(redValue);

  if (irValue < 50000) {
    Serial.println("No finger detected or weak signal.");
  } 
  else {

    if (checkForBeat(irValue)) {

      long currentTime = millis();
      long delta = currentTime - lastBeat;
      lastBeat = currentTime;

      beatsPerMinute = 60.0 / (delta / 1000.0);

      if (beatsPerMinute > 40 && beatsPerMinute < 200) {

        rates[rateSpot++] = (byte)beatsPerMinute;
        rateSpot %= RATE_SIZE;

        beatAvg = 0;
        for (byte i = 0; i < RATE_SIZE; i++) {
          beatAvg += rates[i];
        }

        beatAvg /= RATE_SIZE;

        Serial.print("Current Heart Rate: ");
        Serial.print(beatsPerMinute);
        Serial.println(" BPM");

        Serial.print("Average Heart Rate: ");
        Serial.print(beatAvg);
        Serial.println(" BPM");
      }
    }
  }

  Serial.println("----------------------");

  delay(20);
}
