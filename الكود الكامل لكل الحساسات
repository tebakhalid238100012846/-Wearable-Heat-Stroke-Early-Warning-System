
#include <Wire.h>
#include <math.h>

// Sensor libraries
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_SHT4x.h>
#include <Adafruit_MLX90614.h>

#include "MAX30105.h"
#include "heartRate.h"

// OLED libraries
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>


// ==================================================
// 1. PIN CONFIGURATION
// ==================================================

#define SDA_PIN 4
#define SCL_PIN 5

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define OLED_ADDRESS 0x3C


// ==================================================
// 2. SENSOR OBJECTS
// ==================================================

Adafruit_MPU6050 mpu;
Adafruit_SHT4x sht4;
Adafruit_MLX90614 mlx;

MAX30105 particleSensor;

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  OLED_RESET
);


// ==================================================
// 3. SENSOR STATUS
// ==================================================

bool mpuOK = false;
bool shtOK = false;
bool mlxOK = false;
bool maxOK = false;
bool oledOK = false;


// ==================================================
// 4. SENSOR DATA
// ==================================================

// MPU6050
float accelX = 0;
float accelY = 0;
float accelZ = 0;

float gyroX = 0;
float gyroY = 0;
float gyroZ = 0;

float accelerationMagnitude = 0;


// SHT41
float airTemperature = 0;
float humidity = 0;


// MLX90614
float ambientTemperature = 0;
float objectTemperature = 0;


// MAX30102
long irValue = 0;
long redValue = 0;

float heartRate = 0;
int averageHeartRate = 0;

bool fingerDetected = false;
bool heartRateAvailable = false;


// ==================================================
// 5. HEART RATE SETTINGS
// ==================================================

const byte RATE_SIZE = 4;

byte rates[RATE_SIZE];

byte rateSpot = 0;
byte rateCount = 0;

long lastBeat = 0;


// ==================================================
// 6. PPG GRAPH SETTINGS
// ==================================================

// 128 points for 128 OLED pixels
#define GRAPH_WIDTH 128

long ppgBuffer[GRAPH_WIDTH];

int graphIndex = 0;
int graphCount = 0;


// ==================================================
// 7. TIMING
// ==================================================

unsigned long lastSensorRead = 0;
unsigned long lastDisplayUpdate = 0;
unsigned long lastSerialUpdate = 0;

const unsigned long SENSOR_INTERVAL = 500;
const unsigned long DISPLAY_INTERVAL = 100;
const unsigned long SERIAL_INTERVAL = 1000;


// ==================================================
// 8. ADD SAMPLE TO GRAPH
// ==================================================

void addPPGSample(long value) {

  ppgBuffer[graphIndex] = value;

  graphIndex++;

  if (graphIndex >= GRAPH_WIDTH) {
    graphIndex = 0;
  }

  if (graphCount < GRAPH_WIDTH) {
    graphCount++;
  }
}


// ==================================================
// 9. INITIALIZE SENSORS
// ==================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("WEARABLE HEAT ALERT PROTOTYPE");
  Serial.println("Starting all sensors...");
  Serial.println("================================");

  // Start I2C
  Wire.begin(SDA_PIN, SCL_PIN);

  Wire.setClock(100000);


  // ---------------- OLED ----------------

  if (display.begin(
        SSD1306_SWITCHCAPVCC,
        OLED_ADDRESS
      )) {

    oledOK = true;

    display.clearDisplay();

    display.setTextColor(SSD1306_WHITE);

    display.setTextSize(1);

    display.setCursor(0, 0);

    display.println("WEARABLE DEVICE");

    display.println();

    display.println("Starting sensors...");

    display.display();

    Serial.println("OLED: READY");

  } else {

    Serial.println("OLED: NOT FOUND");
  }


  // ---------------- MPU6050 ----------------

  if (mpu.begin(0x68, &Wire)) {

    mpuOK = true;

  } else if (mpu.begin(0x69, &Wire)) {

    mpuOK = true;
  }

  if (mpuOK) {

    mpu.setAccelerometerRange(
      MPU6050_RANGE_8_G
    );

    mpu.setGyroRange(
      MPU6050_RANGE_500_DEG
    );

    mpu.setFilterBandwidth(
      MPU6050_BAND_21_HZ
    );

    Serial.println("MPU6050: READY");

  } else {

    Serial.println("MPU6050: ERROR");
  }


  // ---------------- SHT41 ----------------

  if (sht4.begin(&Wire)) {

    shtOK = true;

    sht4.setPrecision(
      SHT4X_HIGH_PRECISION
    );

    sht4.setHeater(
      SHT4X_NO_HEATER
    );

    Serial.println("SHT41: READY");

  } else {

    Serial.println("SHT41: ERROR");
  }


  // ---------------- MLX90614 ----------------

  if (mlx.begin(0x5A, &Wire)) {

    mlxOK = true;

    Serial.println("MLX90614: READY");

  } else {

    Serial.println("MLX90614: ERROR");
  }


  // ---------------- MAX30102 ----------------

  if (particleSensor.begin(
        Wire,
        I2C_SPEED_STANDARD
      )) {

    maxOK = true;

    particleSensor.setup(
      60,       // LED brightness
      4,        // Sample average
      2,        // Red + IR
      100,      // Sample rate
      411,      // Pulse width
      4096      // ADC range
    );

    particleSensor.setPulseAmplitudeRed(0x1F);

    particleSensor.setPulseAmplitudeIR(0x1F);

    particleSensor.setPulseAmplitudeGreen(0);

    Serial.println("MAX30102: READY");

  } else {

    Serial.println("MAX30102: ERROR");
  }


  // ---------------- STATUS ----------------

  Serial.println();
  Serial.println("========== SENSOR STATUS ==========");

  Serial.print("MPU6050: ");
  Serial.println(mpuOK ? "READY" : "ERROR");

  Serial.print("SHT41: ");
  Serial.println(shtOK ? "READY" : "ERROR");

  Serial.print("MLX90614: ");
  Serial.println(mlxOK ? "READY" : "ERROR");

  Serial.print("MAX30102: ");
  Serial.println(maxOK ? "READY" : "ERROR");

  Serial.print("OLED: ");
  Serial.println(oledOK ? "READY" : "ERROR");

  Serial.println("===================================");

  delay(1000);
}


// ==================================================
// 10. READ MPU6050
// ==================================================

void readMPU6050() {

  if (!mpuOK) return;

  sensors_event_t a;
  sensors_event_t g;
  sensors_event_t temp;

  mpu.getEvent(&a, &g, &temp);

  accelX = a.acceleration.x;
  accelY = a.acceleration.y;
  accelZ = a.acceleration.z;

  gyroX = g.gyro.x;
  gyroY = g.gyro.y;
  gyroZ = g.gyro.z;

  accelerationMagnitude = sqrt(
    accelX * accelX +
    accelY * accelY +
    accelZ * accelZ
  );
}


// ==================================================
// 11. READ SHT41
// ==================================================

void readSHT41() {

  if (!shtOK) return;

  sensors_event_t humidityEvent;
  sensors_event_t temperatureEvent;

  sht4.getEvent(
    &humidityEvent,
    &temperatureEvent
  );

  airTemperature = temperatureEvent.temperature;

  humidity = humidityEvent.relative_humidity;
}


// ==================================================
// 12. READ MLX90614
// ==================================================

void readMLX90614() {

  if (!mlxOK) return;

  ambientTemperature = mlx.readAmbientTempC();

  objectTemperature = mlx.readObjectTempC();
}


// ==================================================
// 13. PROCESS MAX30102 SAMPLES
// ==================================================

void readMAX30102() {

  if (!maxOK) return;

  // Ask the sensor to load new FIFO samples
  particleSensor.check();

  // Process every available sample
  while (particleSensor.available()) {

    irValue = particleSensor.getIR();

    redValue = particleSensor.getRed();

    // Add raw IR signal to the graph
    addPPGSample(irValue);

    // Approximate finger detection
    fingerDetected = (irValue > 50000);

    if (fingerDetected) {

      // Detect heartbeat
      if (checkForBeat(irValue)) {

        long currentTime = millis();

        if (lastBeat != 0) {

          long delta = currentTime - lastBeat;

          float bpm = 60000.0 / delta;

          if (bpm > 40 && bpm < 200) {

            heartRate = bpm;

            rates[rateSpot] = (byte)bpm;

            rateSpot++;

            rateSpot %= RATE_SIZE;

            if (rateCount < RATE_SIZE) {
              rateCount++;
            }

            int total = 0;

            for (byte i = 0; i < rateCount; i++) {

              total += rates[i];
            }

            averageHeartRate = total / rateCount;

            heartRateAvailable = true;
          }
        }

        lastBeat = currentTime;
      }

    } else {

      heartRateAvailable = false;

      lastBeat = 0;

      rateSpot = 0;
      rateCount = 0;

      averageHeartRate = 0;
    }

    // Move to next FIFO sample
    particleSensor.nextSample();
  }
}


// ==================================================
// 14. DRAW PPG GRAPH
// ==================================================

void drawPPGGraph() {

  // Graph label
  display.setTextSize(1);

  display.setCursor(0, 40);

  display.print("PULSE WAVE");

  if (!maxOK) {

    display.setCursor(0, 51);

    display.print("MAX30102 ERROR");

    return;
  }

  if (!fingerDetected) {

    display.setCursor(0, 51);

    display.print("Place finger");

    return;
  }

  if (graphCount < 2) {

    display.setCursor(0, 51);

    display.print("Reading signal...");

    return;
  }


  // Find minimum and maximum values
  long minValue = ppgBuffer[0];

  long maxValue = ppgBuffer[0];

  int startIndex =
    (graphIndex - graphCount + GRAPH_WIDTH)
    % GRAPH_WIDTH;

  for (int i = 0; i < graphCount; i++) {

    int index =
      (startIndex + i) % GRAPH_WIDTH;

    long value = ppgBuffer[index];

    if (value < minValue) {
      minValue = value;
    }

    if (value > maxValue) {
      maxValue = value;
    }
  }


  // Prevent division by a very small range
  if (maxValue - minValue < 1000) {

    maxValue = minValue + 1000;
  }


  // Draw graph between Y=49 and Y=63
  int previousX = 0;
  int previousY = 56;

  for (int i = 0; i < graphCount; i++) {

    int index =
      (startIndex + i) % GRAPH_WIDTH;

    long value = ppgBuffer[index];

    int x = map(
      i,
      0,
      graphCount - 1,
      0,
      127
    );

    int y = map(
      value,
      minValue,
      maxValue,
      62,
      49
    );

    y = constrain(y, 49, 62);

    if (i > 0) {

      display.drawLine(
        previousX,
        previousY,
        x,
        y,
        SSD1306_WHITE
      );
    }

    previousX = x;

    previousY = y;
  }
}


// ==================================================
// 15. UPDATE OLED DISPLAY
// ==================================================

void updateOLED() {

  if (!oledOK) return;

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);


  // Header
  display.setCursor(0, 0);

  display.print("WEARABLE PROTOTYPE");

  display.drawLine(
    0, 10, 127, 10,
    SSD1306_WHITE
  );


  // Air temperature
  display.setCursor(0, 13);

  display.print("Air:");

  if (shtOK) {

    display.print(airTemperature, 1);

    display.print("C");

  } else {

    display.print("--");
  }


  // Humidity
  display.setCursor(68, 13);

  display.print("RH:");

  if (shtOK) {

    display.print(humidity, 0);

    display.print("%");

  } else {

    display.print("--");
  }


  // Surface temperature
  display.setCursor(0, 24);

  display.print("Surface:");

  if (mlxOK) {

    display.print(objectTemperature, 1);

    display.print("C");

  } else {

    display.print("--");
  }


  // Heart rate
  display.setCursor(0, 33);

  if (fingerDetected && heartRateAvailable) {

    display.print("Heart: ");

    display.print(averageHeartRate);

    display.print(" BPM");

  } else if (fingerDetected) {

    display.print("Heart: Reading...");

  } else {

    display.print("Heart: Place finger");
  }


  // Draw live pulse graph
  drawPPGGraph();

  display.display();
}


// ==================================================
// 16. SERIAL MONITOR OUTPUT
// ==================================================

void printSerialData() {

  Serial.println();

  Serial.println("========== LIVE SENSOR DATA ==========");


  // MPU6050
  Serial.println("[MPU6050]");

  if (mpuOK) {

    Serial.print("Acceleration X: ");
    Serial.print(accelX);

    Serial.print(" | Y: ");
    Serial.print(accelY);

    Serial.print(" | Z: ");
    Serial.println(accelZ);

    Serial.print("Total Acceleration: ");
    Serial.println(accelerationMagnitude);

    Serial.print("Gyroscope X: ");
    Serial.print(gyroX);

    Serial.print(" | Y: ");
    Serial.print(gyroY);

    Serial.print(" | Z: ");
    Serial.println(gyroZ);

  } else {

    Serial.println("Sensor unavailable");
  }


  // SHT41
  Serial.println("[SHT41]");

  if (shtOK) {

    Serial.print("Air Temperature: ");

    Serial.print(airTemperature);

    Serial.println(" C");

    Serial.print("Humidity: ");

    Serial.print(humidity);

    Serial.println(" %");

  } else {

    Serial.println("Sensor unavailable");
  }


  // MLX90614
  Serial.println("[MLX90614]");

  if (mlxOK) {

    Serial.print("Ambient Temperature: ");

    Serial.print(ambientTemperature);

    Serial.println(" C");

    Serial.print("Object Temperature: ");

    Serial.print(objectTemperature);

    Serial.println(" C");

  } else {

    Serial.println("Sensor unavailable");
  }


  // MAX30102
  Serial.println("[MAX30102]");

  if (maxOK) {

    Serial.print("IR: ");

    Serial.println(irValue);

    Serial.print("RED: ");

    Serial.println(redValue);

    if (fingerDetected && heartRateAvailable) {

      Serial.print("Average Heart Rate: ");

      Serial.print(averageHeartRate);

      Serial.println(" BPM");

    } else if (!fingerDetected) {

      Serial.println("Place finger on sensor");

    } else {

      Serial.println("Waiting for heartbeat...");
    }

  } else {

    Serial.println("Sensor unavailable");
  }


  Serial.println("======================================");
}


// ==================================================
// 17. MAIN LOOP
// ==================================================

void loop() {

  unsigned long currentMillis = millis();


  // Read MAX30102 continuously
  readMAX30102();


  // Read other sensors every 500 ms
  if (
    currentMillis - lastSensorRead
    >= SENSOR_INTERVAL
  ) {

    lastSensorRead = currentMillis;

    readMPU6050();

    readSHT41();

    readMLX90614();
  }


  // Update OLED every 100 ms
  if (
    currentMillis - lastDisplayUpdate
    >= DISPLAY_INTERVAL
  ) {

    lastDisplayUpdate = currentMillis;

    updateOLED();
  }


  // Print Serial data every second
  if (
    currentMillis - lastSerialUpdate
    >= SERIAL_INTERVAL
  ) {

    lastSerialUpdate = currentMillis;

    printSerialData();
  }
}
